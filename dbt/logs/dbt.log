        a_runs.credits_used AS 'compute_cost',
        a_runs.row_count AS 'records_processed',
        a_runs.env AS 'environment',
        ( CASE 
                    WHEN state IN ('SUCCEEDED','COMPLETED') THEN TRUE
                    WHEN state = 'RUNNING' THEN NULL
                    ELSE FALSE END) AS 'is_success'
    FROM 
        "monitoring"."raw"."raw_pipeline_a_runs" AS a_runs
)
SELECT *
FROM run_a
  );

