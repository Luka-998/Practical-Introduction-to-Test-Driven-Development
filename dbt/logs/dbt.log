  create view "monitoring"."main"."stg_pipeline_runs__dbt_tmp" as (
    

with run_a AS (
    SELECT 
        a_runs.execution_uuid AS "run_id",
        a_runs.workflow AS "pipeline_name",
        'raw_pipeline_a_runs' AS 'source_system'
        (CASE 
